# Copy this file to .env and change what you need. .env is never committed.

# The AI: any OpenAI-compatible chat server. Leave AI_BASE_URL empty to use code-only answers (no AI).
#   LM Studio: http://127.0.0.1:1234/v1     Ollama: http://127.0.0.1:11434/v1
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=lm-studio
AI_MODEL=qwen3-8b-instruct
AI_MAX_TOKENS=1200
AI_TIMEOUT_S=90

# Optional
# IB_PORT=8000           the port run.py tries first
# IB_DATA_DIR=           another data folder (default: data/ next to run.py)
# IB_NO_AI=1             ignore the AI settings above
# IB_NO_SAMPLE=1         don't make the sample case at start-up
# IB_SYNC_JOBS=1         run background jobs inline (tests)
